generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model Tenant { id String @id @default(cuid()); name String; status String @default("active"); createdAt DateTime @default(now()); users User[]; stores Store[]; products Product[]; orders Order[]; categories Category[] }
model User { id String @id @default(cuid()); tenantId String; email String; name String; role String; status String @default("active"); tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade); createdAt DateTime @default(now()); @@unique([tenantId,email]); @@index([tenantId]) }
model Store { id String @id @default(cuid()); tenantId String; platform String; name String; country String; currency String; status String; credentials Json?; tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade); createdAt DateTime @default(now()); @@index([tenantId,platform]) }
model Product { id String @id @default(cuid()); tenantId String; spu String; name String; brand String?; description String?; status String; metadata Json?; tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade); skus Sku[]; contents ProductContent[]; categories ProductCategory[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([tenantId,spu]) }
model Sku { id String @id @default(cuid()); productId String; sku String; barcode String?; cost Decimal @db.Decimal(18,4); weightGram Decimal? @db.Decimal(18,4); attributes Json?; product Product @relation(fields:[productId], references:[id], onDelete:Cascade); createdAt DateTime @default(now()); @@unique([productId,sku]) }
model ProductContent { id String @id @default(cuid()); productId String; locale String; channel String?; title String?; bullets Json?; description String?; seo Json?; media Json?; version Int @default(1); status String; product Product @relation(fields:[productId], references:[id], onDelete:Cascade); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([productId,locale,channel]) }
model Category { id String @id @default(cuid()); tenantId String; parentId String?; name String; code String; status String @default("active"); tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade); parent Category? @relation("CategoryTree", fields:[parentId], references:[id], onDelete:SetNull); children Category[] @relation("CategoryTree"); products ProductCategory[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([tenantId,code]); @@index([tenantId,parentId]) }
model ProductCategory { productId String; categoryId String; product Product @relation(fields:[productId], references:[id], onDelete:Cascade); category Category @relation(fields:[categoryId], references:[id], onDelete:Cascade); @@id([productId,categoryId]) }
model Order { id String @id @default(cuid()); tenantId String; externalId String; platform String; storeId String; currency String; totalAmount Decimal @db.Decimal(18,4); status String; riskStatus String; rawData Json?; tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([tenantId,platform,externalId]); @@index([tenantId,status]) }
model InventoryBalance { id String @id @default(cuid()); tenantId String; skuId String; warehouseId String; available Int @default(0); reserved Int @default(0); inbound Int @default(0); damaged Int @default(0); safetyStock Int @default(0); updatedAt DateTime @updatedAt; @@unique([tenantId,skuId,warehouseId]) }
model AuditLog { id String @id @default(cuid()); tenantId String; userId String?; action String; entity String; entityId String?; payload Json?; createdAt DateTime @default(now()); @@index([tenantId,createdAt]) }
